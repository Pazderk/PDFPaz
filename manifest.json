{
  "manifest_version": 3,
  "name": "Brog's PDF Editor",
  "version": "1.3.0",
  "description": "100% client-side PDF editor docked to the browser's side panel: pick pages to keep, rotate, fill or add form fields, watermark, split, and summarize with Chrome's on-device AI. No files ever leave your browser.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Brog's PDF Editor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["downloads", "sidePanel", "unlimitedStorage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
